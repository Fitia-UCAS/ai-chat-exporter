{
  "manifest_version": 3,
  "name": "AI Chat Exporter",
  "version": "2.2.0",
  "description": "在 ChatGPT / Gemini / DeepSeek 一键导出当前对话为 Markdown（极简 / 完整 / 详尽）",
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://*.oaiusercontent.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.usercontent.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "导出当前 AI 对话",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "content/core.js",
        "content/markdown.js",
        "content/exporter.js",
        "content/ui.js",
        "content/adapters/chatgpt.js",
        "content/adapters/gemini.js",
        "content/adapters/deepseek.js",
        "content/main.js",
        "content/button.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*"
      ],
      "resources": [
        "icons/*",
        "content/ui.css"
      ]
    }
  ]
}
